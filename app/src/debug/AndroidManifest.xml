<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Debug builds only: lets adb trigger a background celebration. -->
        <receiver
            android:name=".debug.DebugCelebrateReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.hourlysteps.debug.CELEBRATE" />
            </intent-filter>
        </receiver>
        <!-- Debug builds only: lets adb pretend a workout or sleep is in progress. -->
        <receiver
            android:name=".debug.DebugActivityReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.hourlysteps.debug.SET_ACTIVITY" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
